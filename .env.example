NODE_ENV=production
PORT=3000
SITE_URL=https://your-domain.example
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/uzapps?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=UZ APPS Admin
SEED_STARTER=true
MAX_UPLOAD_MB=250

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://cdn.example.com
# Optional override. Default is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
